  "pages": {
    "accredited": {
      "title": {
        "en": "Accredited accommodation list"
      },
      "intro": {
        "en": "On a real campus this is the housing office's official list. These residences are fictional, like Sizwe itself."
      },
      "items": [
        {
          "name": "Sizwe Student Village",
          "detail": {
            "en": "University residence · on campus · catered"
          }
        },
        {
          "name": "Sizwe North Residence",
          "detail": {
            "en": "University residence · 5 minutes' walk · self-catering"
          }
        },
        {
          "name": "Umoya House",
          "detail": {
            "en": "Accredited private residence · 10 minutes' walk · NSFAS-accredited"
          }
        },
        {
          "name": "Ilanga Court",
          "detail": {
            "en": "Accredited private residence · on the campus shuttle route · NSFAS-accredited"
          }
        }
      ],
      "note": {
        "en": "Not on the list? Don't pay anything. Ask the Residence Office first."
      }
    },
    "workshops": {
      "title": {
        "en": "Academic skills workshop calendar"
      },
      "intro": {
        "en": "Free, every week of term, no booking needed. A real campus publishes a calendar like this on its website."
      },
      "items": [
        {
          "name": "Time management",
          "detail": {
            "en": "Tuesdays 13:00 · Library, Seminar Room 2"
          }
        },
        {
          "name": "Academic writing",
          "detail": {
            "en": "Wednesdays 13:00 · Library, Seminar Room 2"
          }
        },
        {
          "name": "Study methods and exam preparation",
          "detail": {
            "en": "Thursdays 13:00 · Library, Seminar Room 2"
          }
        },
        {
          "name": "Referencing and research",
          "detail": {
            "en": "Fridays 12:00 · Library, Seminar Room 2"
          }
        }
      ],
      "note": {
        "en": "Missed one? The Academic Success Centre also books one-on-one sessions."
      }
    },
    "result_codes": {
      "title": {
        "en": "Exam result codes"
      },
      "intro": {
        "en": "On a real campus this is the official list of result codes. Every university uses its own codes: these are examples, like Sizwe itself."
      },
      "items": [
        {
          "name": "999 · Supplementary exam",
          "detail": {
            "en": "You narrowly missed the pass mark and may write again. Confirm by the deadline."
          }
        },
        {
          "name": "998 · Sick (deferred) exam",
          "detail": {
            "en": "You were ill and handed in a medical certificate. You write on a later date."
          }
        },
        {
          "name": "997 · Absent",
          "detail": {
            "en": "You did not write and gave no accepted reason. See your faculty office at once."
          }
        },
        {
          "name": "996 · Not admitted to the exam",
          "detail": {
            "en": "Your semester mark was too low to write. Ask an advisor about repeating the module."
          }
        },
        {
          "name": "995 · Result outstanding",
          "detail": {
            "en": "Your mark is not captured yet, or is held back for unpaid fees. Ask before you worry."
          }
        }
      ],
      "note": {
        "en": "A supp usually needs a final mark just below the pass mark, often 40–49%. It is written within weeks, so check the date now."
      }
    },
    "apply": {
      "title": {
        "en": "Apply to Sizwe University"
      },
      "intro": {
        "en": "On a real campus this opens the university's own application site. Sizwe University is fictional, so these steps are an example."
      },
      "items": [
        {
          "name": "1 · Check the requirements",
          "detail": {
            "en": "Each course lists the subjects and marks it needs. Check before you pay a fee."
          }
        },
        {
          "name": "2 · Apply online, yourself",
          "detail": {
            "en": "Use your own email address and phone number, so the replies come to you."
          }
        },
        {
          "name": "3 · Upload your documents",
          "detail": {
            "en": "A certified copy of your ID and your latest school results."
          }
        },
        {
          "name": "4 · Keep your reference number",
          "detail": {
            "en": "Use it to track your application and to answer every message before its deadline."
          }
        },
        {
          "name": "Applications open and close",
          "detail": {
            "en": "Example dates: 1 April to 30 September. Residence applications close earlier."
          }
        }
      ],
      "note": {
        "en": "Apply only on the official site. Nobody can apply for you for a fee, and nobody can sell you a place."
      }
    }
  },
