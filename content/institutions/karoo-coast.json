  "pages": {
    "accredited": {
      "title": {
        "en": "Accredited private accommodation"
      },
      "intro": {
        "en": "Karoo Coast has no residences of its own, so this list matters. These places are fictional, like the university."
      },
      "note": {
        "en": "Not on the list? Don't pay anything. Ask the Housing Desk first."
      },
      "items": [
        {
          "name": "Seagull House",
          "detail": {
            "en": "Accredited private residence · 8 minutes' walk · NSFAS-accredited"
          }
        },
        {
          "name": "Dune Court",
          "detail": {
            "en": "Accredited private residence · on the town shuttle route · NSFAS-accredited"
          }
        },
        {
          "name": "Lighthouse Lodge",
          "detail": {
            "en": "Accredited private residence · 15 minutes' walk · self-catering"
          }
        }
      ]
    },
    "result_codes": {
      "title": {
        "en": "Exam result codes"
      },
      "intro": {
        "en": "On a real campus this is the official list of result codes. Every university uses its own codes: these are examples, like Karoo Coast itself."
      },
      "note": {
        "en": "A supp usually needs a final mark just below the pass mark, often 40–49%. It is written within weeks, so check the date now."
      },
      "items": [
        {
          "name": "SUP · Supplementary exam",
          "detail": {
            "en": "You narrowly missed the pass mark and may write again. Confirm by the deadline."
          }
        },
        {
          "name": "DEF · Sick (deferred) exam",
          "detail": {
            "en": "You were ill and handed in a medical certificate. You write on a later date."
          }
        },
        {
          "name": "ABS · Absent",
          "detail": {
            "en": "You did not write and gave no accepted reason. See your faculty office at once."
          }
        },
        {
          "name": "NAD · Not admitted to the exam",
          "detail": {
            "en": "Your semester mark was too low to write. Ask an advisor about repeating the module."
          }
        },
        {
          "name": "OUT · Result outstanding",
          "detail": {
            "en": "Your mark is not captured yet, or is held back for unpaid fees. Ask before you worry."
          }
        }
      ]
    },
    "apply": {
      "title": {
        "en": "Apply to Karoo Coast University"
      },
      "intro": {
        "en": "On a real campus this opens the university's own application site. Karoo Coast University is fictional, so these steps are an example."
      },
      "note": {
        "en": "Apply only on the official site. Nobody can apply for you for a fee, and nobody can sell you a place."
      },
      "items": [
        {
          "name": "1 · Check the requirements",
          "detail": {
            "en": "Each course lists the subjects and marks it needs. Check before you pay a fee."
          }
        },
        {
          "name": "2 · Apply online, yourself",
          "detail": {
            "en": "Use your own email address and phone number, so the replies come to you."
          }
        },
        {
          "name": "3 · Upload your documents",
          "detail": {
            "en": "A certified copy of your ID and your latest school results."
          }
        },
        {
          "name": "4 · Keep your reference number",
          "detail": {
            "en": "Use it to track your application and to answer every message before its deadline."
          }
        },
        {
          "name": "Applications open and close",
          "detail": {
            "en": "Example dates: 1 April to 30 September. Residence applications close earlier."
          }
        }
      ]
    }
  },
