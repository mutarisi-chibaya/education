              },
              "support": [
                "commuters",
                "campus_safety"
              ],
              "outcome": {
                "en": "The Day Students' Room has a list for the 7pm shuttle, which only runs when students book it. You book every Tuesday."
              },
              "tip": {
                "en": "Ask what runs on request. Late shuttles and security escorts often only run when someone books them."
              }
            }
          ]
