      "type": "random",
      "pool": "ex_random",
      "weight": 3,
      "title": {
        "en": "Sick on exam day"
      },
      "text": {
        "en": "You wake up with a high fever on the morning of your {mod2} exam. You can barely stand, and the exam starts at 9."
      },
      "forecast_tags": [
        "test_stress",
        "wellbeing"
      ],
      "choices": [
        {
          "id": "write",
          "tags": [
            "self_sacrificer"
          ],
          "label": {
            "en": "Write it anyway"
          },
          "effects": {
            "wellbeing": -8
          },
          "flags": [
            "exam_sick"
          ],
          "outcome": {
            "en": "You get through two questions before the room starts spinning. Once you sit an exam, the mark usually stands."
          }
        },
        {
          "id": "bed",
          "tags": [
