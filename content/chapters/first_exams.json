  "events": [
    {
      "id": "EX-02",
      "type": "core",
      "week": 1,
      "title": {
        "en": "Study help: what's worth paying for?"
      },
      "text": {
        "en": "Exams are three weeks away. A tutor charges R250 an hour, seniors sell notes for R150, and someone offers to write your assignment for R300. The department runs free tutorials."
      },
      "forecast_tags": [
        "test_stress",
        "money_shortfall"
      ],
      "research": "Student interviews (October 2026): study help costs",
      "choices": [
        {
          "id": "tutor",
          "label": {
            "en": "Pay a private tutor"
          },
          "effects": {
            "money": -500,
            "marks": 3
          },
          "flags": [
            "paid_tutor"
          ],
          "outcome": {
            "en": "Two sessions help with one module. R500 is gone before exams start."
          }
        },
        {
          "id": "notes",
          "label": {
            "en": "Buy notes and past papers"
          },
          "effects": {
            "money": -150,
            "marks": 1
          },
          "flags": [
            "bought_notes"
          ],
          "outcome": {
            "en": "The notes are two years old, and part of the syllabus has changed."
          }
        },
        {
          "id": "cheat",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Pay someone to write it"
          },
          "effects": {
            "money": -300,
            "marks": -3,
            "wellbeing": -5
          },
          "flags": [
            "paid_help"
          ],
          "outcome": {
            "en": "The work comes back copied from the internet. Handing it in could mean a misconduct hearing, so you redo it yourself."
          },
          "tip": {
            "en": "Handing in work someone else did is academic misconduct. It can cost you the module, or your place."
          }
        },
        {
          "id": "free",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Free tutorials and past papers"
          },
          "effects": {
            "marks": 5
          },
          "flags": [
            "free_help"
          ],
          "support": [
            "coach",
            "library"
          ],
          "outcome": {
            "en": "The department's tutorials are free, and past papers are on the library site. You go twice a week."
          },
          "tip": {
            "en": "Check what's free before you pay: tutorials, past papers and consultation hours."
          }
        }
      ]
    },
    {
      "id": "EX-01",
      "type": "core",
      "week": 2,
      "title": {
        "en": "Three exams in four days"
      },
      "text": {
        "en": "The exam timetable is out: {mod1}, {mod2} and a third module, back to back."
      },
      "forecast_tags": [
        "test_stress"
      ],
      "choices": [
        {
          "id": "cram",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Cram all night"
          },
          "effects": {
            "wellbeing": -10
          },
          "flags": [
            "exam_cram"
          ],
          "outcome": {
            "en": "You cover everything once, badly, and run on coffee."
          }
        },
        {
          "id": "timetable",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Make a study timetable"
          },
          "effects": {
            "wellbeing": 5
          },
          "flags": [
            "exam_timetable"
          ],
          "outcome": {
            "en": "Two-hour blocks, breaks and sleep. It's boring, and it works."
          },
          "tip": {
            "en": "Your exam timetable is on the student portal. Academic skills workshops hand out ready-made study planners."
          }
        },
        {
          "id": "drop",
          "tags": [
            "self_sacrificer"
          ],
          "label": {
            "en": "Drop all social plans"
          },
          "effects": {
            "wellbeing": -5,
            "connection": -1
          },
          "flags": [
            "dropped_social"
          ],
          "outcome": {
            "en": "You get the hours in. Your friends notice you've disappeared."
          }
        }
      ]
    },
    {
      "id": "EX-04",
      "type": "core",
      "week": 3,
      "sensitive": true,
      "title": {
        "en": "Exam anxiety"
      },
      "text": {
        "en": "The night before your first exam, your heart is racing and your mind goes blank when you look at your notes."
      },
      "forecast_tags": [
        "wellbeing",
        "test_stress"
      ],
      "choices": [
        {
          "id": "push",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Push through"
          },
          "effects": {
            "wellbeing": -10
          },
          "flags": [
            "anxiety_pushed"
          ],
          "outcome": {
            "en": "You sit the exam on two hours of sleep. Your hands shake for the first ten minutes."
          }
        },
        {
          "id": "calm",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Breathing, then sleep"
          },
          "effects": {
            "wellbeing": 10
          },
          "flags": [
            "anxiety_calm"
          ],
          "outcome": {
            "en": "You close the books at ten, do a breathing exercise and sleep. Morning-you is grateful."
          }
        },
        {
          "id": "talk",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Talk to someone"
          },
          "effects": {
            "wellbeing": 15
          },
          "flags": [
            "anxiety_helped"
          ],
          "support": [
            "counselling"
          ],
          "outcome": {
            "en": "A counsellor teaches you a grounding technique for the exam hall. You use it twice."
          }
        }
      ]
    },
    {
      "id": "EX-T",
      "type": "tests",
      "week": 3,
      "title": {
        "en": "Exam week"
      },
      "text": {
        "en": "Your first university exams. Everything you did this term counts now."
      },
      "forecast_tags": [
        "test_stress"
      ]
    },
    {
      "id": "EX-05",
      "type": "core",
      "week": 4,
      "conditions": {
        "tests": {
          "anyFail": true
        }
      },
      "title": {
        "en": "You failed {failed}"
      },
      "text": {
        "en": "Results are out. You passed some exams, but not {failed}. It's a shock, and it's also common in first year."
      },
      "forecast_tags": [
        "funding_risk",
        "wellbeing"
      ],
      "choices": [
        {
          "id": "hide",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Hide it"
          },
          "effects": {
            "wellbeing": -10
          },
          "outcome": {
            "en": "You tell everyone it went fine. The weight of it follows you home."
          }
        },
        {
          "id": "options",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Find out your options"
          },
          "effects": {
            "wellbeing": 5
          },
          "support": [
            "progression"
          ],
          "outcome": {
            "en": "You check three things: what {failed} blocks next year, how many credits your funder needs, and when you can repeat it. It is bad news, but now it has edges."
          },
          "tip": {
            "en": "A failed module can block the ones that follow it. Look up its prerequisites in the faculty handbook before you plan next semester."
          }
        },
        {
          "id": "advisor",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Talk to an advisor"
          },
          "effects": {
            "wellbeing": 10
          },
          "flags": [
            "advisor_plan"
          ],
          "support": [
            "advisor"
          ],
          "outcome": {
            "en": "The advisor shows you what {failed} blocks, what it does to your funding, and the soonest you can repeat it. You leave with a plan for next semester."
          },
          "tip": {
            "en": "Ask three questions: what does this block, what does it mean for my funding, and when can I repeat it?"
          }
        }
      ]
    },
    {
      "id": "EX-SU",
      "type": "core",
      "week": 4,
      "title": {
        "en": "A code instead of a mark"
      },
      "text": {
        "en": "Results are in. Your key modules show marks, but next to {mod3} there is no mark, only a code: {suppCode}. Your stomach drops."
      },
      "forecast_tags": [
        "wellbeing"
      ],
      "choices": [
        {
          "id": "assume",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Assume the worst"
          },
          "effects": {
            "wellbeing": -8
          },
          "support": [
            "supp_exams"
          ],
          "outcome": {
            "en": "You spend two days sure that you failed, and nearly miss the deadline to confirm. Then you find out that code {suppCode} was never a fail: it means you are admitted to a supplementary exam, a second chance to write."
          }
        },
        {
          "id": "lookup",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Look up the code"
          },
          "effects": {
            "wellbeing": 5
          },
          "support": [
            "supp_exams"
          ],
          "outcome": {
            "en": "Code {suppCode} means you are admitted to a supplementary exam: a second chance to write. You note the date and confirm that you will be there."
          },
          "tip": {
            "en": "A supp is a second opportunity, not a verdict on you. Plenty of graduates wrote one in first year."
          }
        },
        {
          "id": "perusal",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Ask to see my script"
          },
          "effects": {
            "wellbeing": 8
          },
          "support": [
            "supp_exams",
            "lecturer"
          ],
          "outcome": {
            "en": "At the perusal you see exactly where the marks went, and your lecturer points you to the past papers to practise. Now you know what to study."
          },
          "tip": {
            "en": "Study what you got wrong, not everything again. Past papers and a tutor beat rereading your notes."
          }
        }
      ]
    },
    {
      "id": "EX-W1",
      "type": "win",
      "week": 4,
      "conditions": {
        "tests": {
          "anyFail": false
        }
      },
      "title": {
        "en": "You passed the module you feared most"
      },
      "text": {
        "en": "{mod1}: passed. You read the result three times to be sure."
      },
      "effects": {
        "wellbeing": 10
      }
    },
    {
      "id": "EX-07",
      "type": "situational",
      "week": 5,
      "slot": "spine",
      "conditions": {
        "funding": [
          "bursary"
        ]
      },
      "title": {
        "en": "Your bursary is cut off mid-year"
      },
      "text": {
        "en": "An email from your bursary: funding is suspended because your results or paperwork fell short. Your stipend stops this month, and you have ten days to appeal."
      },
      "forecast_tags": [
        "funding_risk",
        "money_shortfall"
      ],
      "research": "Student interviews (October 2026): bursary cuts",
      "choices": [
        {
          "id": "panic",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Panic"
          },
          "effects": {
            "wellbeing": -10
          },
          "flags": [
            "funding_lost"
          ],
          "outcome": {
            "en": "You close the email and don't reply. The appeal deadline is still ten days away."
          }
        },
        {
          "id": "appeal",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Appeal"
          },
          "effects": {
            "wellbeing": 5
          },
          "flags": [
            "appealed"
          ],
          "outcome": {
            "en": "You send your results, a motivation and a study plan. The bursary agrees to review your case."
          },
          "tip": {
            "en": "The appeal steps and deadline are in your bursary contract. Email your bursary officer, and keep copies of everything you send."
          }
        },
        {
          "id": "help",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Ask financial aid about funding"
          },
          "effects": {
            "wellbeing": 10
          },
          "flags": [
            "appealed"
          ],
          "support": [
            "financial_aid_office"
          ],
          "outcome": {
            "en": "Financial aid helps you write the appeal and lists other funding you can apply for now."
          },
          "tip": {
            "en": "Read your bursary contract for the pass requirements and the appeal process before you need them."
          }
        }
      ]
    },
    {
      "id": "EX-06",
      "type": "core",
      "week": 5,
      "title": {
        "en": "What your results mean for funding and progression"
      },
      "text": {
        "en": "A notice explains that funders check how many credits you pass, and that some modules unlock second-year ones."
      },
      "forecast_tags": [
        "funding_risk"
      ],
      "choices": [
        {
          "id": "ignore",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Ignore it for now"
          },
          "effects": {
            "wellbeing": 0
          },
          "outcome": {
            "en": "You archive the email. It'll still be true next semester."
          }
        },
        {
          "id": "check",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Check the rules"
          },
          "effects": {
            "wellbeing": 5
          },
          "support": [
            "progression",
            "financial_aid_office"
          ],
          "outcome": {
            "en": "You work out how many credits you need this year, and write it on your wall."
          }
        },
        {
          "id": "plan",
          "tags": [
            "help_seeker",
            "planner"
          ],
          "label": {
            "en": "Plan next semester"
          },
          "effects": {
            "wellbeing": 5
          },
          "flags": [
            "advisor_plan"
          ],
          "support": [
            "advisor"
          ],
          "outcome": {
            "en": "Your module plan for next semester is checked against progression rules. No surprises later."
          }
        }
      ],
      "slot": "spine",
      "conditions": {
        "funding": [
          "nsfas",
          "bursary"
        ]
      }
    },
    {
      "id": "EX-08",
      "type": "core",
      "week": 6,
      "title": {
        "en": "Holidays: go home, or stay and work?"
      },
      "text": {
        "en": "Three weeks off. Home is calling, and a campus café is hiring for the holidays."
      },
      "forecast_tags": [
        "family_pressure",
        "money_shortfall"
      ],
      "choices": [
        {
          "id": "home",
          "tags": [
            "connector"
          ],
          "label": {
            "en": "Go home"
          },
          "effects": {
            "money": -400,
            "wellbeing": 10
          },
          "outcome": {
            "en": "Home food, your own bed, and everyone asking how varsity is. Travel and gifts cost R400."
          }
        },
        {
          "id": "work",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Stay and work"
          },
          "effects": {
            "money": 1200,
            "wellbeing": -5,
            "connection": -1,
            "buffer": 1
          },
          "outcome": {
            "en": "You earn R1 200 and start next semester with a buffer. You miss home more than you expected."
          },
          "tip": {
            "en": "Holiday jobs are advertised by career services, the SRC and on campus notice boards. Apply before exams end."
          }
        },
        {
          "id": "split",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Split the time"
          },
          "effects": {
            "money": 400,
            "wellbeing": 5
          },
          "outcome": {
            "en": "Two weeks working, one week home. A bit of both."
          }
        }
      ]
    },
    {
