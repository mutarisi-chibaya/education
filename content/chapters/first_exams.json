          }
        }
      ]
    },
    {
      "id": "EX-F1",
      "type": "friend_story",
      "pool": "ex_friend",
      "title": {
        "en": "A friend failed and wants to drop out"
      },
      "text": {
        "en": "Your friend failed two exams and says they're going home for good. \"I'm not made for this.\""
      },
      "choices": [
        {
          "id": "agree",
          "label": {
            "en": "Agree it might be best"
          },
          "effects": {},
          "outcome": {
            "en": "They pack that weekend. Leaving can be right for some people, but they never found out their options."
          }
        },
        {
          "id": "options",
          "label": {
            "en": "Help them find their options"
          },
          "effects": {
            "connection": 1,
            "help_seeking": 1
          },
          "support": [
            "advisor"
          ],
          "outcome": {
            "en": "Together you check what each failed module blocks, what it means for their funding, and when they can repeat. With an advisor's plan, they can still progress."
          },
          "tip": {
            "en": "Failing a module is rarely the end. What matters is what it blocks, what the funder requires, and how soon it can be repeated."
          }
        },
        {
          "id": "support",
          "label": {
            "en": "Connect them to support"
          },
          "effects": {
            "connection": 1,
            "help_seeking": 1
          },
          "support": [
            "counselling",
            "advisor"
          ],
          "outcome": {
            "en": "You sit with them while they book a counselling session. They stay, and they thank you months later."
          }
        }
      ]
    },
    {
