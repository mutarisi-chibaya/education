{
  "id": "finish_line",
  "title": {
    "en": "Finish Line"
  },
  "subtitle": {
    "en": "Final year: projects, jobs and graduation"
  },
  "blurb": {
    "en": "Final-year pressure, applications, old debts and the walk across the stage. About 6 minutes."
  },
  "unit": {
    "en": "Week"
  },
  "weeks": 6,
  "economy": true,
  "friday": true,
  "slots": [
    {
      "pool": "surprise",
      "weeks": [
        1,
        2,
        3,
        4
      ]
    },
    {
      "pool": "subscriptions",
      "weeks": [
        3,
        4
      ]
    },
    {
      "pool": "life",
      "weeks": [
        2,
        3,
        4,
        5
      ]
    }
  ],
  "events": [
    {
      "id": "FL-01",
      "type": "core",
      "week": 1,
      "title": {
        "en": "Final-year project pressure"
      },
      "text": {
        "en": "Your final-year project counts for a big part of your degree, and the deadline is twelve weeks away."
      },
      "forecast_tags": [
        "test_stress"
      ],
      "choices": [
        {
          "id": "late",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Leave it until later"
          },
          "effects": {
            "marks": -5
          },
          "outcome": {
            "en": "Twelve weeks feels like forever. Until it's six."
          }
        },
        {
          "id": "milestones",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Plan milestones, join a writing workshop"
          },
          "effects": {
            "marks": 5
          },
          "outcome": {
            "en": "The writing centre's research workshop helps you set a chapter every two weeks. It already feels smaller."
          },
          "support": [
            "workshops"
          ]
        },
        {
          "id": "supervisor",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Meet your supervisor"
          },
          "effects": {
            "marks": 5,
            "wellbeing": 5
          },
          "outcome": {
            "en": "Your supervisor narrows your topic in twenty minutes. Clarity is a gift."
          }
        }
      ]
    },
    {
      "id": "FL-02",
      "type": "core",
      "week": 2,
      "title": {
        "en": "Graduate programme applications, and rejections"
      },
      "text": {
        "en": "Six applications sent, four rejections back. Your classmates keep posting offers."
      },
      "forecast_tags": [
        "career"
      ],
      "choices": [
        {
          "id": "stop",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Stop applying"
          },
          "effects": {
            "wellbeing": -5
          },
          "outcome": {
            "en": "It stops the sting, and also the chances."
          }
        },
        {
          "id": "feedback",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Ask for feedback"
          },
          "effects": {
            "wellbeing": 5
          },
          "support": [
            "careers"
          ],
          "outcome": {
            "en": "Career services rework your CV. The next two applications get interviews."
          },
          "tip": {
            "en": "University career fairs bring employers to campus, usually once or twice a year. Career services publish the dates and will check your CV beforehand."
          }
        },
        {
          "id": "widen",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Widen your search"
          },
          "effects": {
            "wellbeing": 5
          },
          "outcome": {
            "en": "Smaller companies, public sector and internships. More doors than you thought."
          },
          "tip": {
            "en": "Go to the university career fair with printed CVs, and check the career services portal and your department's notice board for graduate programmes and internships."
          },
          "support": [
            "careers"
          ]
        }
      ]
    },
    {
      "id": "FL-03",
      "type": "recurring",
      "week": 3,
      "title": {
        "en": "Friends finish before you"
      },
      "text": {
        "en": "Your closest friends have finished or moved for work, and loneliness comes back. {memory}"
      },
      "forecast_tags": [
        "loneliness"
      ],
      "research": "DHET cohort data: few graduate in minimum time",
      "choices": [
        {
          "id": "isolate",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Isolate"
          },
          "effects": {
            "wellbeing": -10,
            "connection": -1
          },
          "outcome": {
            "en": "You stop going to campus unless you have to."
          }
        },
        {
          "id": "celebrate",
          "tags": [
            "connector"
          ],
          "label": {
            "en": "Celebrate them"
          },
          "effects": {
            "wellbeing": 5
          },
          "outcome": {
            "en": "You go to their graduation and cheer the loudest. Their win doesn't make you less."
          }
        },
        {
          "id": "people",
          "tags": [
            "connector"
          ],
          "label": {
            "en": "Find your people"
          },
          "effects": {
            "wellbeing": 5,
            "connection": 1
          },
          "support": [
            "societies"
          ],
          "outcome": {
            "en": "You join a final-year study circle. Everyone there is also figuring it out."
          }
        }
      ]
    },
    {
      "id": "FL-04",
      "type": "situational",
      "week": 4,
      "slot": "spine",
      "conditions": {
        "trackers": {
          "debt": {
            "gte": 1
          }
        }
      },
      "title": {
        "en": "Your certificate is held back until fees are paid"
      },
      "text": {
        "en": "The debt from earlier years caught up with you: the university says your certificate stays with them until your balance is settled."
      },
      "forecast_tags": [
        "debt"
      ],
      "research": "RU Game: outstanding student debt",
      "choices": [
        {
          "id": "give_up",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Give up on it"
          },
          "effects": {
            "wellbeing": -10
          },
          "outcome": {
            "en": "Without the certificate, job applications stall."
          }
        },
        {
          "id": "plan",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Set up a payment plan"
          },
          "effects": {
            "wellbeing": 5,
            "debt": -1
          },
          "support": [
            "fees"
          ],
          "outcome": {
            "en": "A monthly plan you can afford, and a letter confirming your degree for employers in the meantime."
          }
        },
        {
          "id": "relief",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Look for debt relief programmes"
          },
          "effects": {
            "wellbeing": 10,
            "debt": -1
          },
          "support": [
            "fees",
            "financial_aid_office"
          ],
          "outcome": {
            "en": "The fees office points you to a programme that helps clear historic student debt. You apply that week."
          }
        }
      ]
    },
    {
      "id": "FL-05",
      "type": "situational",
      "week": 4,
      "slot": "spine",
      "conditions": {
        "flags": [
          "repeating_module"
        ]
      },
      "title": {
        "en": "Funding is running out because you've taken longer"
      },
      "text": {
        "en": "The repeated module means an extra semester, and your funding only covers the minimum time plus a little."
      },
      "forecast_tags": [
        "funding_risk",
        "money_shortfall"
      ],
      "choices": [
        {
          "id": "drop",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Drop out"
          },
          "effects": {
            "wellbeing": -10
          },
          "outcome": {
            "en": "You stop one semester short. It's not the end of options, but it's a hard place to restart from."
          }
        },
        {
          "id": "parttime",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Study part-time and work"
          },
          "effects": {
            "wellbeing": 0
          },
          "outcome": {
            "en": "Slower, but you finish."
          },
          "tip": {
            "en": "Ask your faculty office how to change to part-time registration, and ask your funder what it does to your funding."
          }
        },
        {
          "id": "appeal",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Appeal, or find a bursary"
          },
          "effects": {
            "wellbeing": 10
          },
          "support": [
            "financial_aid_office"
          ],
          "outcome": {
            "en": "The financial aid office helps you apply for a final-semester bursary."
          }
        }
      ]
    },
    {
      "id": "FL-07",
      "type": "core",
      "week": 4,
      "slot": "spine",
      "title": {
        "en": "\"Do I actually feel job-ready?\""
      },
      "text": {
        "en": "You're about to graduate, and you're not sure what you can actually do at work."
      },
      "forecast_tags": [
        "career"
      ],
      "research": "Understanding Students: many feel work skills underdeveloped",
      "choices": [
        {
          "id": "hope",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Hope for the best"
          },
          "effects": {
            "wellbeing": 0
          },
          "outcome": {
            "en": "Maybe it will be fine. You don't check."
          }
        },
        {
          "id": "skills",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Build a skill this term"
          },
          "effects": {
            "wellbeing": 5
          },
          "outcome": {
            "en": "A free online course and a small project to show employers."
          },
          "tip": {
            "en": "Your library login often gives free access to online courses. Career services can tell you which skills employers in your field ask for."
          }
        },
        {
          "id": "careers",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Get career support"
          },
          "effects": {
            "wellbeing": 10
          },
          "support": [
            "careers"
          ],
          "outcome": {
            "en": "A mock interview shows you can explain your degree better than you thought."
          }
        }
      ]
    },
    {
      "id": "FL-06",
      "type": "core",
      "week": 5,
      "title": {
        "en": "A job offer far from home"
      },
      "text": {
        "en": "You're offered a job in another province. At home, everyone assumed you'd come back and help."
      },
      "forecast_tags": [
        "family_pressure",
        "career"
      ],
      "tradeoff": true,
      "choices": [
        {
          "id": "decline",
          "label": {
            "en": "Decline and stay near home"
          },
          "effects": {
            "wellbeing": -5,
            "family_obligation": 1
          },
          "outcome": {
            "en": "Home is grateful. You keep looking for work closer by."
          }
        },
        {
          "id": "accept",
          "label": {
            "en": "Accept"
          },
          "effects": {
            "wellbeing": 5
          },
          "outcome": {
            "en": "A hard conversation, then a plan: you'll send money monthly and visit in December."
          }
        },
        {
          "id": "negotiate",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Negotiate"
          },
          "effects": {
            "wellbeing": 5
          },
          "outcome": {
            "en": "The employer agrees to a later start date, so you can help settle things at home first."
          }
        }
      ]
    },
    {
      "id": "FL-08",
      "type": "core",
      "week": 6,
      "title": {
        "en": "Graduation costs"
      },
      "text": {
        "en": "Gown hire, photos and travel for your family add up to about R1 500. You have {money}."
      },
      "forecast_tags": [
        "money_shortfall",
        "family_pressure"
      ],
      "choices": [
        {
          "id": "skip",
          "tags": [
            "self_sacrificer"
          ],
          "label": {
            "en": "Skip the ceremony"
          },
          "effects": {
            "wellbeing": -10
          },
          "outcome": {
            "en": "You save the money. Your family is quietly disappointed."
          }
        },
        {
          "id": "budget",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Budget for it"
          },
          "effects": {
            "money": -1500,
            "wellbeing": 5
          },
          "outcome": {
            "en": "You saved a little each month. Everyone is there."
          }
        },
        {
          "id": "help",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Ask about help with costs"
          },
          "effects": {
            "money": -500,
            "wellbeing": 5
          },
          "support": [
            "fees"
          ],
          "outcome": {
            "en": "You borrow a gown from a graduate and share transport with another family. R500 instead of R1 500."
          }
        }
      ]
    },
    {
      "id": "FL-W1",
      "type": "win",
      "week": 6,
      "title": {
        "en": "Graduation day"
      },
      "text": {
        "en": "Your name is read out. Somewhere in the hall, someone from home is ululating. You made it."
      },
      "effects": {
        "wellbeing": 20
      }
    }
  ],
  "fridayWeeks": [
    2,
    4
  ],
  "budget": {
    "cards": 6,
    "minis": 2
  },
  "recap": [
    "financial_aid_office",
    "food_programme",
    "counselling",
    "workshops",
    "advisor",
    "fees",
    "careers"
  ],
  "minis": [
    {
      "id": "MM-GRAD",
      "type": "mini",
      "text": {
        "en": "Do you know exactly which modules and credits you still need to graduate?"
      },
      "choices": [
        {
          "label": {
            "en": "Ask for a degree audit"
          },
          "effects": {
            "confidence": 1
          },
          "outcome": {
            "en": "Your faculty office checks your record against the degree rules. One missing module now is a fix; in December it is another year."
          }
        },
        {
          "label": {
            "en": "I think I'm fine"
          },
          "effects": {},
          "outcome": {
            "en": "You probably are. If you want to be sure, the faculty office can confirm it in a few minutes."
          }
        }
      ]
    }
  ]
}
