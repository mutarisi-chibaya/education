    {
      "id": "MM-EXCL-BB",
      "type": "mini",
      "text": {
        "en": "Do you know how many modules you must pass this year to be allowed to continue?"
      },
      "choices": [
        {
          "label": {
            "en": "Check the rules now"
          },
          "effects": {
            "confidence": 1
          },
          "outcome": {
            "en": "The faculty handbook gives the credits you must pass each year to avoid academic exclusion. Now you know where your line is."
          }
        },
        {
          "label": {
            "en": "Check only if I fail"
          },
          "effects": {},
