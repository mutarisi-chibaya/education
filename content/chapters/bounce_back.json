  "events": [
    {
      "id": "BB-01",
      "type": "situational",
      "week": 1,
      "slot": "spine",
      "conditions": {
        "flags": [
          "failed_module"
        ]
      },
      "title": {
        "en": "A failed module blocks your registration"
      },
      "text": {
        "en": "You registered your modules for the whole year in January. The one you failed is a prerequisite for a second-semester module, and the system is about to block it."
      },
      "forecast_tags": [
        "funding_risk",
        "test_stress"
      ],
      "choices": [
        {
          "id": "ignore",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Leave it and hope"
          },
          "effects": {
            "wellbeing": -5,
            "marks": -2
          },
          "outcome": {
            "en": "Three weeks in, the system removes you from the blocked module. The time you put into it is gone."
          }
        },
        {
          "id": "substitute",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Look for a substitute module"
          },
          "effects": {
            "wellbeing": 3
          },
          "outcome": {
            "en": "The faculty handbook lists a module you can take instead this semester. You swap before the deadline."
          },
          "tip": {
            "en": "The faculty handbook on the university website lists the prerequisites and alternatives for every module."
          }
        },
        {
          "id": "advisor",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Fix registration with an advisor"
          },
          "effects": {
            "wellbeing": 10
          },
          "flags": [
            "advisor_plan"
          ],
          "support": [
            "advisor"
          ],
          "outcome": {
            "en": "The advisor finds a substitute where one exists and deregisters the module that's blocked. Your timetable works again."
          },
          "tip": {
            "en": "After every results release, check which modules your failed module blocks, before registration closes."
          }
        }
      ]
    },
    {
      "id": "BB-00",
      "type": "core",
      "week": 1,
      "slot": "spine",
      "title": {
        "en": "You passed, but not by enough"
      },
      "text": {
        "en": "You registered for the whole year in January. You passed {mod1}, but your mark is below what the second-semester module you chose requires."
      },
      "forecast_tags": [
        "test_stress",
        "funding_risk"
      ],
      "choices": [
        {
          "id": "ignore",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Leave it and hope"
          },
          "effects": {
            "wellbeing": -5,
            "marks": -2
          },
          "outcome": {
            "en": "Two weeks in, the system removes you from the module. You join the other version late and have to catch up."
          }
        },
        {
          "id": "switch",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Switch to the other version"
          },
          "effects": {
            "wellbeing": 3
          },
          "outcome": {
            "en": "You change to the version of the module your mark allows, before the deadline. You start it on day one."
          },
          "tip": {
            "en": "Module changes are made on the student portal or at your faculty office, before the published deadline."
          }
        },
        {
          "id": "advisor",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Ask an advisor what it changes"
          },
          "effects": {
            "wellbeing": 5
          },
          "flags": [
            "advisor_plan"
          ],
          "support": [
            "advisor"
          ],
          "outcome": {
            "en": "The advisor shows you which version still leads to the second-year modules you want, and fixes your registration."
          },
          "tip": {
            "en": "After results, check the entry marks for your next modules before the change deadline."
          }
        }
      ]
    },
    {
      "id": "BB-07",
      "type": "core",
      "week": 4,
      "title": {
        "en": "Going to see your lecturer"
      },
      "text": {
        "en": "Tests are next week and one {mod1} topic still doesn't make sense. Your lecturer has consultation hours on Tuesdays, but you've never been."
      },
      "forecast_tags": [
        "test_stress"
      ],
      "research": "Understanding Students Issue 2: few students talk to lecturers",
      "choices": [
        {
          "id": "avoid",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Avoid it"
          },
          "effects": {
            "wellbeing": 0
          },
          "outcome": {
            "en": "It feels easier not to go. The same mistakes show up in your next assignment."
          }
        },
        {
          "id": "email",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Send an email"
          },
          "effects": {
            "marks": 2
          },
          "flags": [
            "lecturer_email"
          ],
          "outcome": {
            "en": "They reply with two tips and a link to past papers."
          },
          "tip": {
            "en": "Lecturers' email addresses and consultation times are in the module guide. Write from your student email and give your student number."
          }
        },
        {
          "id": "visit",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Go to consultation hours"
          },
          "effects": {
            "marks": 5
          },
          "flags": [
            "lecturer_consult"
          ],
          "support": [
            "lecturer"
          ],
          "outcome": {
            "en": "Ten minutes, and they remember your name afterwards. You finally get the topic that kept tripping you up."
          }
        }
      ]
    },
    {
      "id": "BB-02",
      "type": "situational",
      "week": 2,
      "slot": "spine",
      "conditions": {
        "flags": [
          "failed_module"
        ]
      },
      "title": {
        "en": "Repeating a module alongside new ones"
      },
      "text": {
        "en": "Your timetable now has the module you failed plus a full new load. Two lectures clash on Wednesdays."
      },
      "forecast_tags": [
        "test_stress"
      ],
      "choices": [
        {
          "id": "overload",
          "tags": [
            "self_sacrificer"
          ],
          "label": {
            "en": "Take everything on"
          },
          "effects": {
            "wellbeing": -10
          },
          "flags": [
            "repeating_module",
            "overload"
          ],
          "outcome": {
            "en": "You're in every lecture you can make, and exhausted by Thursday."
          }
        },
        {
          "id": "drop",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Drop an elective"
          },
          "effects": {
            "wellbeing": 5
          },
          "flags": [
            "repeating_module",
            "dropped_elective"
          ],
          "outcome": {
            "en": "One elective moves to next year. The repeat gets the time it needs."
          }
        },
        {
          "id": "advisor",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Plan it with an advisor"
          },
          "effects": {
            "wellbeing": 5
          },
          "flags": [
            "repeating_module",
            "advisor_plan"
          ],
          "support": [
            "advisor"
          ],
          "outcome": {
            "en": "The advisor finds a class group without the clash. Your semester suddenly fits."
          }
        }
      ]
    },
    {
      "id": "BB-05",
      "type": "core",
      "week": 2,
      "slot": "spine",
      "title": {
        "en": "A part-time job offer"
      },
      "text": {
        "en": "A shop near campus offers you weekend and evening shifts: about R300 a week."
      },
      "forecast_tags": [
        "money_shortfall",
        "test_stress"
      ],
      "choices": [
        {
          "id": "take",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Take all the shifts"
          },
          "effects": {
            "wellbeing": -5
          },
          "flags": [
            "took_job"
          ],
          "recurring": {
            "effects": {
              "money": 600
            },
            "label": {
              "en": "Part-time wages"
            }
          },
          "outcome": {
            "en": "Money stops being a daily worry. Study time shrinks."
          }
        },
        {
          "id": "decline",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Decline for now"
          },
          "effects": {
            "wellbeing": 0
          },
          "outcome": {
            "en": "You keep your evenings for study and ask them to keep your CV."
          }
        },
        {
          "id": "fewer",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Take fewer hours"
          },
          "effects": {
            "wellbeing": 0
          },
          "flags": [
            "job_fewer_hours"
          ],
          "recurring": {
            "effects": {
              "money": 300
            },
            "label": {
              "en": "Part-time wages"
            }
          },
          "outcome": {
            "en": "One weekend shift. A little money, without losing your week."
          }
        }
      ]
    },
    {
      "id": "BB-03",
      "type": "core",
      "week": 3,
      "title": {
        "en": "\"Am I in the wrong course?\""
      },
      "text": {
        "en": "Everyone else seems to love {course}. You're not sure you even like it."
      },
      "forecast_tags": [
        "wellbeing"
      ],
      "choices": [
        {
          "id": "quit",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Quit"
          },
          "effects": {
            "wellbeing": -5
          },
          "outcome": {
            "en": "You fill in the form, then stop at the last line. Leaving is a real option, but you want to decide it with facts, not on a bad week."
          }
        },
        {
          "id": "push",
          "tags": [
            "self_sacrificer"
          ],
          "label": {
            "en": "Push through it"
          },
          "effects": {
            "wellbeing": -3,
            "marks": 1
          },
          "outcome": {
            "en": "You keep your head down and the doubt stays. It may pass, but it's worth talking through before next year's registration."
          }
        },
        {
          "id": "change",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Look into changing course"
          },
          "effects": {
            "wellbeing": 5
          },
          "outcome": {
            "en": "You find out which credits would carry over. Knowing the options calms you down."
          },
          "tip": {
            "en": "Your faculty office handles course changes. Ask which credits transfer, and when internal transfer applications close."
          }
        },
        {
          "id": "careers",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Talk to a careers advisor"
          },
          "effects": {
            "wellbeing": 10
          },
          "flags": [
            "careers_talk"
          ],
          "support": [
            "careers"
          ],
          "outcome": {
            "en": "The careers advisor shows you jobs your degree leads to that you'd never heard of. One of them sounds like you."
          }
        }
      ]
    },
    {
      "id": "BB-04",
      "type": "recurring",
      "week": 4,
      "title": {
        "en": "A close friend drops out"
      },
      "text": {
        "en": "A close friend leaves university, and loneliness comes back. {memory}"
      },
      "forecast_tags": [
        "loneliness"
      ],
      "choices": [
        {
          "id": "withdraw",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Withdraw"
          },
          "effects": {
            "wellbeing": -10,
            "connection": -1
          },
          "outcome": {
            "en": "You eat alone and skip the group chat. The weeks get longer."
          }
        },
        {
          "id": "touch",
          "tags": [
            "connector"
          ],
          "label": {
            "en": "Stay in touch with them"
          },
          "effects": {
            "wellbeing": 5
          },
          "outcome": {
            "en": "You call every Sunday. They're doing okay, and so are you."
          }
        },
        {
          "id": "new",
          "tags": [
            "connector"
          ],
          "label": {
            "en": "Build new connections"
          },
          "effects": {
            "wellbeing": 5,
            "connection": 1
          },
          "support": [
            "societies"
          ],
          "outcome": {
            "en": "You join a society's weekly meet-up. Slowly, a new group forms around you."
          }
        }
      ],
      "variants": [
        {
          "conditions": {
            "flags": [
              "came_with_friend"
            ]
          },
          "title": {
            "en": "The friend you came with leaves"
          },
          "text": {
            "en": "The friend you came to university with is leaving, and loneliness comes back. {memory}"
          }
        }
      ]
    },
    {
      "id": "BB-06",
      "type": "situational",
      "week": 5,
      "conditions": {
        "flags": [
          "failed_module"
        ],
        "funding": [
          "nsfas",
          "bursary"
        ]
      },
      "title": {
        "en": "Your funding is at risk: appeal"
      },
      "text": {
        "en": "A message from your funder: your results may not meet the rules to keep funding. You can appeal."
      },
      "forecast_tags": [
        "funding_risk"
      ],
      "choices": [
        {
          "id": "give_up",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Give up on it"
          },
          "effects": {
            "wellbeing": -10
          },
          "flags": [
            "funding_lost"
          ],
          "outcome": {
            "en": "You don't appeal. Next year's funding is now a question mark."
          }
        },
        {
          "id": "appeal",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Appeal with evidence"
          },
          "effects": {
            "wellbeing": 5
          },
          "flags": [
            "appealed"
          ],
          "outcome": {
            "en": "You attach your results plan and a letter explaining what happened. Now you wait."
          },
          "tip": {
            "en": "Appeal forms and deadlines are on your funder's portal. Attach your results, a short explanation and any proof."
          }
        },
        {
          "id": "help",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Get help writing it"
          },
          "effects": {
            "wellbeing": 10
          },
          "flags": [
            "appealed"
          ],
          "support": [
            "financial_aid_office"
          ],
          "outcome": {
            "en": "Financial aid has helped with dozens of appeals. Yours goes in on time, with the right documents."
          }
        }
      ]
    },
    {
