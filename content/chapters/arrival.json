    {
      "id": "ARR-03",
      "type": "what_if",
      "week": 1,
      "conditions": {
        "housing": [
          "residence"
        ]
      },
      "title": {
        "en": "What if res is overbooked?"
      },
      "text": {
        "en": "Some years, res accepts more students than it has beds. Imagine you arrive and there's no room for you. Outside, people offer rooms: \"for students, pay the R1 500 deposit today\"."
      },
      "forecast_tags": [
        "housing"
      ],
      "research": "RU Game: residence crisis",
      "choices": [
        {
          "id": "take",
          "label": {
            "en": "Take the first room offered"
          },
          "effects": {
            "money": -1500,
            "wellbeing": -10
          },
          "flags": [
            "saw_res_overbooked"
          ],
          "outcome": {
            "en": "You hand over the R1 500 deposit. The \"landlord\" stops answering: it was a scam, it happens every year, and it's not your fault."
          },
          "tip": {
            "en": "A real landlord lets you view the room and gives you a lease. Check the university's accredited list before paying anyone."
          },
          "support": [
            "verify_accom"
          ],
          "takesAll": true,
          "variants": [
            {
              "conditions": {
                "moneyBelow": 1500
              },
              "outcome": {
                "en": "You hand over every rand you have and borrow {borrowed} from a friend to make up the R1 500. The \"landlord\" stops answering: it was a scam, it happens every year, and it's not your fault."
              }
            }
          ],
          "icon": "😢"
        },
        {
          "id": "check",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Check it's legitimate first"
          },
          "effects": {
            "wellbeing": 0
          },
          "support": [
            "verify_accom"
          ],
          "outcome": {
            "en": "The address doesn't match the photos. You walk away and keep looking on the university's accredited list."
          },
          "flags": [
            "saw_res_overbooked"
          ],
          "icon": "🙂"
        },
        {
          "id": "ask",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Ask the university for help"
          },
          "effects": {
            "wellbeing": 5
          },
          "support": [
            "residence_office"
          ],
          "outcome": {
            "en": "The housing office finds you a temporary place and keeps you on the list. A room opens up in week two."
          },
          "flags": [
            "saw_res_overbooked"
          ],
          "icon": "🙂"
        }
      ]
    },
