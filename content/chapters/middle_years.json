{
  "id": "middle_years",
  "title": {
    "en": "Middle Years"
  },
  "subtitle": {
    "en": "Second and third year: leases, majors and side hustles"
  },
  "blurb": {
    "en": "Old fees, moving off campus, choosing a major, part-time work, family expectations and burnout. About 6 minutes."
  },
  "unit": {
    "en": "Week"
  },
  "weeks": 6,
  "economy": true,
  "friday": true,
  "fridayWeeks": [
    2,
    4
  ],
  "slots": [
    {
      "pool": "surprise",
      "weeks": [
        1,
        2,
        3,
        4
      ]
    },
    {
      "pool": "repayment",
      "weeks": [
        1,
        2
      ]
    },
    {
      "pool": "subscriptions",
      "weeks": [
        3,
        4
      ]
    },
    {
      "pool": "life",
      "weeks": [
        2,
        3,
        4,
        5
      ],
      "weight": 2
    }
  ],
  "events": [
    {
      "id": "MY-00",
      "type": "situational",
      "week": 1,
      "slot": "spine",
      "conditions": {
        "trackers": {
          "debt": {
            "gte": 1
          }
        }
      },
      "title": {
        "en": "You can't register: outstanding fees"
      },
      "text": {
        "en": "The registration system blocks you: there's an outstanding balance from last year. Classes start on Monday."
      },
      "forecast_tags": [
        "debt",
        "money_shortfall"
      ],
      "research": "RU Game: outstanding student debt",
      "choices": [
        {
          "id": "panic",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Panic and wait"
          },
          "effects": {
            "wellbeing": -10
          },
          "outcome": {
            "en": "A week passes. You miss the first lectures and the block is still there."
          }
        },
        {
          "id": "plan",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Set up a payment plan"
          },
          "effects": {
            "wellbeing": 5,
            "debt": -1
          },
          "support": [
            "fees"
          ],
          "outcome": {
            "en": "A monthly arrangement you can afford, and the block is lifted the same day."
          },
          "tip": {
            "en": "Fees offices would rather arrange a plan than lose a student. Ask early."
          }
        },
        {
          "id": "relief",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Ask about debt relief"
          },
          "effects": {
            "wellbeing": 10,
            "debt": -1
          },
          "support": [
            "fees",
            "financial_aid_office"
          ],
          "outcome": {
            "en": "The SRC helps you apply to a programme that clears part of historic student debt, and you're registered while it's processed."
          }
        }
      ]
    },
    {
      "id": "MY-02",
      "type": "core",
      "week": 1,
      "slot": "spine",
      "title": {
        "en": "Choosing your electives"
      },
      "text": {
        "en": "You have to pick your electives for {course} by Friday. Your friends are all choosing the same two."
      },
      "forecast_tags": [
        "career"
      ],
      "choices": [
        {
          "id": "friends",
          "tags": [
            "connector"
          ],
          "label": {
            "en": "Follow your friends"
          },
          "effects": {
            "wellbeing": 3
          },
          "outcome": {
            "en": "Same classes, same study group. You're not sure you love the work."
          }
        },
        {
          "id": "interest",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Follow what interests you"
          },
          "effects": {
            "marks": 4
          },
          "outcome": {
            "en": "New classmates, but the work actually holds your attention."
          }
        },
        {
          "id": "careers",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Ask a careers advisor"
          },
          "effects": {
            "marks": 3,
            "wellbeing": 5
          },
          "support": [
            "careers"
          ],
          "outcome": {
            "en": "You see which electives lead to which jobs, and pick with your eyes open."
          }
        }
      ]
    },
    {
      "id": "MY-01",
      "type": "core",
      "week": 2,
      "title": {
        "en": "Moving off campus: lease, deposit, housemates"
      },
      "text": {
        "en": "Three friends want to share a house near campus. The agent wants a signed lease and a R2 000 deposit, split four ways, by tomorrow. You have {money}."
      },
      "forecast_tags": [
        "housing",
        "money_shortfall"
      ],
      "choices": [
        {
          "id": "sign",
          "label": {
            "en": "Sign quickly"
          },
          "effects": {
            "money": -800,
            "wellbeing": -5
          },
          "flags": [
            "bad_lease"
          ],
          "outcome": {
            "en": "The lease makes you liable for the whole house's water bill. The first one, R300, arrives with your R500 share of the deposit."
          }
        },
        {
          "id": "read",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Read the lease first"
          },
          "effects": {
            "money": -500
          },
          "outcome": {
            "en": "You spot the water-bill clause and get it changed before signing."
          }
        },
        {
          "id": "senior",
          "tags": [
            "connector"
          ],
          "label": {
            "en": "View it with a senior"
          },
          "effects": {
            "money": -500,
            "wellbeing": 3
          },
          "support": [
            "verify_accom"
          ],
          "outcome": {
            "en": "A fourth-year spots the damp and the dodgy clause. You negotiate both."
          },
          "tip": {
            "en": "No senior to ask? A res mentor, the SRC or the accommodation office can look at a lease with you before you sign."
          }
        },
        {
          "id": "stay",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Stay where you live now"
          },
          "effects": {
            "wellbeing": 2
          },
          "outcome": {
            "en": "You tell your friends you're staying put this year. No deposit, no move, and you visit their house on weekends."
          }
        }
      ]
    },
    {
      "id": "MY-09",
      "type": "core",
      "week": 2,
      "title": {
        "en": "The work changes gear"
      },
      "text": {
        "en": "Second year is a step up: longer reports, more reading and less guidance. The study habits that got you through first year aren't keeping up."
      },
      "forecast_tags": [
        "test_stress"
      ],
      "choices": [
        {
          "id": "alone",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Work longer hours alone"
          },
          "effects": {
            "marks": 1,
            "wellbeing": -8
          },
          "outcome": {
            "en": "More hours, same methods. You're tired, and the marks barely move."
          }
        },
        {
          "id": "group",
          "tags": [
            "connector"
          ],
          "label": {
            "en": "Start a study group"
          },
          "effects": {
            "marks": 3,
            "wellbeing": 2
          },
          "outcome": {
            "en": "Four of you meet twice a week and take turns explaining a topic. Teaching it is how you finally learn it."
          },
          "tip": {
            "en": "Post in the class group or ask your tutor to connect you. Most libraries have group study rooms you can book."
          }
        },
        {
          "id": "workshops",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Join academic skills workshops"
          },
          "effects": {
            "marks": 5,
            "wellbeing": 3
          },
          "support": [
            "workshops"
          ],
          "outcome": {
            "en": "Three free workshops: time management, academic writing and study methods. Your next report takes half the time."
          }
        }
      ]
    },
    {
      "id": "MY-04",
      "type": "recurring",
      "week": 3,
      "conditions": {
        "flags": [
          "repeating_module"
        ]
      },
      "title": {
        "en": "Your friends move ahead without you"
      },
      "text": {
        "en": "Because of one repeated module, your friends are in third-year classes while you're still finishing second-year ones. {memory}"
      },
      "forecast_tags": [
        "loneliness"
      ],
      "choices": [
        {
          "id": "hide",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Hide it"
          },
          "effects": {
            "wellbeing": -10,
            "connection": -1
          },
          "outcome": {
            "en": "You stop going to the group's study sessions so nobody asks."
          }
        },
        {
          "id": "tell",
          "tags": [
            "connector"
          ],
          "label": {
            "en": "Tell them"
          },
          "effects": {
            "wellbeing": 5
          },
          "outcome": {
            "en": "One of them repeated a module too. Nobody thinks less of you."
          }
        },
        {
          "id": "new",
          "tags": [
            "connector"
          ],
          "label": {
            "en": "Make new study friends"
          },
          "effects": {
            "wellbeing": 5,
            "marks": 3
          },
          "outcome": {
            "en": "Your new classmates are keen and organised. You catch up together."
          }
        }
      ],
      "slot": "spine"
    },
    {
      "id": "MY-03",
      "type": "core",
      "week": 3,
      "title": {
        "en": "A side hustle"
      },
      "text": {
        "en": "Your braiding, tutoring or design work is getting noticed, and people want to pay you for it."
      },
      "forecast_tags": [
        "money_shortfall",
        "test_stress"
      ],
      "choices": [
        {
          "id": "big",
          "label": {
            "en": "Go big"
          },
          "effects": {
            "marks": -5,
            "wellbeing": -5
          },
          "flags": [
            "side_hustle"
          ],
          "recurring": {
            "effects": {
              "money": 400
            },
            "label": {
              "en": "Side-hustle income"
            }
          },
          "outcome": {
            "en": "The money is good. Your evenings disappear."
          }
        },
        {
          "id": "steady",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Small and steady"
          },
          "effects": {
            "wellbeing": 3
          },
          "flags": [
            "side_hustle"
          ],
          "recurring": {
            "effects": {
              "money": 200
            },
            "label": {
              "en": "Side-hustle income"
            }
          },
          "outcome": {
            "en": "Weekends only. A little extra money and your studies stay on track."
          }
        },
        {
          "id": "later",
          "label": {
            "en": "Not now"
          },
          "effects": {},
          "outcome": {
            "en": "You keep a list of interested clients for the holidays."
          }
        }
      ],
      "slot": "spine"
    },
    {
      "id": "MY-05",
      "type": "recurring",
      "week": 4,
      "slot": "spine",
      "conditions": {
        "family_needs": [
          "yes"
        ]
      },
      "amount": {
        "share": 0.3,
        "min": 300,
        "round": 50
      },
      "title": {
        "en": "Home expects more as you get closer to earning"
      },
      "text": {
        "en": "Now that you're halfway through, home asks for {amount} a month. \"You'll be earning soon anyway.\" You have {money}."
      },
      "forecast_tags": [
        "family_pressure"
      ],
      "tradeoff": true,
      "choices": [
        {
          "id": "send",
          "label": {
            "en": "Send more"
          },
          "effects": {
            "money": "-amount",
            "wellbeing": 3,
            "family_obligation": 1
          },
          "outcome": {
            "en": "Home is proud and grateful. Your month gets very tight."
          }
        },
        {
          "id": "limit",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Set a monthly limit"
          },
          "effects": {
            "money": "-half",
            "family_obligation": 1
          },
          "outcome": {
            "en": "You agree on half, every month, on payday. Everyone knows what to expect."
          },
          "tip": {
            "en": "Decide upfront what share of your money you can send each month, and tell home when your money arrives so they can plan too."
          }
        },
        {
          "id": "explain",
          "tags": [
            "connector"
          ],
          "label": {
            "en": "Explain your plan"
          },
          "effects": {
            "wellbeing": -3
          },
          "outcome": {
            "en": "You show them your budget and when you'll graduate. It's a hard talk, and it helps."
          }
        }
      ]
    },
    {
      "id": "MY-07",
      "type": "core",
      "week": 4,
      "slot": "spine",
      "title": {
        "en": "A chance to tutor or lead a society"
      },
      "text": {
        "en": "Your lecturer asks if you'd tutor first-years, and your society needs a new treasurer."
      },
      "forecast_tags": [
        "career"
      ],
      "research": "High-impact practices: peer teaching and leadership",
      "choices": [
        {
          "id": "decline",
          "label": {
            "en": "Decline"
          },
          "effects": {},
          "outcome": {
            "en": "You keep your time for your own work."
          }
        },
        {
          "id": "accept",
          "tags": [
            "connector"
          ],
          "label": {
            "en": "Accept both"
          },
          "effects": {
            "marks": 3,
            "wellbeing": -3,
            "money": 300
          },
          "outcome": {
            "en": "Teaching makes you understand your own subject better. You're busy."
          }
        },
        {
          "id": "small",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Try a small role"
          },
          "effects": {
            "marks": 2,
            "wellbeing": 2
          },
          "outcome": {
            "en": "One tutorial a week. It looks great on your CV."
          }
        }
      ]
    },
    {
      "id": "MY-06",
      "type": "core",
      "week": 5,
      "title": {
        "en": "Vacation work and internships"
      },
      "text": {
        "en": "Applications for vacation work open this week. You've never written a CV or spoken to a lecturer about careers."
      },
      "forecast_tags": [
        "career"
      ],
      "choices": [
        {
          "id": "skip",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Skip it this year"
          },
          "effects": {},
          "outcome": {
            "en": "You'll try next year. Classmates come back with experience on their CVs."
          }
        },
        {
          "id": "widely",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Apply widely"
          },
          "effects": {
            "wellbeing": -2
          },
          "flags": [
            "applied_vacation"
          ],
          "outcome": {
            "en": "Twelve applications on your own. A couple of replies come back."
          },
          "tip": {
            "en": "Vacancies are posted on the career services portal, at career fairs and on department notice boards."
          }
        },
        {
          "id": "cv",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Get CV help first"
          },
          "effects": {
            "wellbeing": 5
          },
          "flags": [
            "applied_vacation",
            "cv_help"
          ],
          "support": [
            "careers",
            "lecturer"
          ],
          "outcome": {
            "en": "Career services fix your CV, and your lecturer writes a reference."
          }
        }
      ]
    },
    {
      "id": "MY-08",
      "type": "core",
      "week": 6,
      "sensitive": true,
      "title": {
        "en": "Burnout"
      },
      "text": {
        "en": "Classes, work, family and everything else. You're tired in a way sleep doesn't fix, and nothing feels interesting any more."
      },
      "forecast_tags": [
        "wellbeing"
      ],
      "choices": [
        {
          "id": "push",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Push through"
          },
          "effects": {
            "wellbeing": -10,
            "marks": -3
          },
          "outcome": {
            "en": "You get through the week, running on empty."
          }
        },
        {
          "id": "rest",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Rest, and cut something"
          },
          "effects": {
            "wellbeing": 10
          },
          "outcome": {
            "en": "You drop one commitment and take a real weekend off. It helps more than you expected."
          }
        },
        {
          "id": "help",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Get help"
          },
          "effects": {
            "wellbeing": 15,
            "marks": 2
          },
          "support": [
            "counselling"
          ],
          "outcome": {
            "en": "A counsellor helps you see the pattern and plan your load for next semester."
          }
        }
      ]
    },
    {
      "id": "MY-W1",
      "type": "win",
      "week": 6,
      "conditions": {
        "flags": [
          "applied_vacation"
        ]
      },
      "title": {
        "en": "You land vacation work"
      },
      "text": {
        "en": "An email: you start in December. Real work experience, and money for next year."
      },
      "effects": {
        "wellbeing": 10,
        "money": 1000
      }
    },
    {
      "id": "MY-W2",
      "type": "win",
      "week": 6,
      "conditions": {
        "marksGte": 70
      },
      "title": {
        "en": "Dean's List"
      },
      "text": {
        "en": "Your name is on the Dean's List. Your family shares it with everyone they know."
      },
      "research": "RU Game: Dean's List",
      "effects": {
        "wellbeing": 10
      }
    },
    {
      "id": "MY-10",
      "type": "situational",
      "week": 5,
      "conditions": {
        "funding": [
          "nsfas",
          "bursary"
        ]
      },
      "title": {
        "en": "Your funding will not continue"
      },
      "text": {
        "en": "An email from your funder: your funding stops at the end of this year. You missed a pass requirement, or you've used the years it covers."
      },
      "forecast_tags": [
        "funding_risk",
        "money_shortfall"
      ],
      "choices": [
        {
          "id": "panic",
          "tags": [
            "avoider"
          ],
          "label": {
            "en": "Tell no one"
          },
          "effects": {
            "wellbeing": -10
          },
          "flags": [
            "funding_lost"
          ],
          "outcome": {
            "en": "You carry it alone for weeks. Next year's registration is still coming."
          }
        },
        {
          "id": "appeal",
          "tags": [
            "planner"
          ],
          "label": {
            "en": "Appeal the decision"
          },
          "effects": {
            "wellbeing": 5
          },
          "flags": [
            "appealed"
          ],
          "outcome": {
            "en": "You send your results, a motivation and proof of what happened. The funder agrees to review it."
          },
          "tip": {
            "en": "Appeal forms and deadlines are on your funder's portal. Attach your results, a short explanation and any proof."
          }
        },
        {
          "id": "help",
          "tags": [
            "help_seeker"
          ],
          "label": {
            "en": "Ask financial aid what else exists"
          },
          "effects": {
            "wellbeing": 10
          },
          "flags": [
            "appealed"
          ],
          "support": [
            "financial_aid_office",
            "fees"
          ],
          "outcome": {
            "en": "Financial aid helps you appeal, and lists what the university itself offers: its own bursaries, hardship funds and payment plans."
          },
          "tip": {
            "en": "Funding problems are not only a first-year thing. The financial aid office helps senior students too, and faculties often have bursaries for second and third years."
          }
        }
      ]
    }
  ],
  "budget": {
    "cards": 9,
    "minis": 3
  },
  "recap": [
    "financial_aid_office",
    "food_programme",
    "counselling",
    "workshops",
    "advisor",
    "fees"
  ],
  "minis": [
    {
      "id": "MM-VAC",
      "type": "mini",
      "text": {
        "en": "Some degrees require vacation work as part of a module. Do you know if yours does?"
      },
      "choices": [
        {
          "label": {
            "en": "Check your module guide"
          },
          "effects": {
            "confidence": 1
          },
          "outcome": {
            "en": "Yours needs it before final year. {svc_careers}, and your faculty's placement office if it has one, help students find a place."
          }
        },
        {
          "label": {
            "en": "Deal with it later"
          },
          "effects": {},
          "outcome": {
            "en": "Placements fill early. When you are ready, start with {svc_careers} or your faculty office."
          }
        }
      ]
    },
    {
      "id": "MM-EXCL-MY",
      "type": "mini",
      "text": {
        "en": "Do you know how many modules you must pass this year to be allowed to continue?"
      },
      "choices": [
        {
          "label": {
            "en": "Check the rules now"
          },
          "effects": {
            "confidence": 1
          },
          "outcome": {
            "en": "The faculty handbook gives the credits you must pass each year to avoid academic exclusion. Now you know where your line is."
          }
        },
        {
          "label": {
            "en": "Check only if I fail"
          },
          "effects": {},
          "outcome": {
            "en": "Fair enough. It is under \"progression\" or \"exclusion rules\" on the university website, or ask your faculty office."
          }
        }
      ]
    }
  ]
}
